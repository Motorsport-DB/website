{
    "_doc": [
        "Settings of the MotorsportDB ELO (computed by bin/build.php at every start).",
        "Every race is replayed in chronological order; drivers gain or lose points against the drivers they are compared with.",
        "mode: 'teammate' = different cars (F1, Grand Prix motorcycles): only against the drivers of the same team;",
        "      'window'   = similar cars: against the 'window' cars ranked just above and just below;",
        "      'spec'     = identical cars: against the whole field (of the same class).",
        "base: rating of a newcomer in this championship (the level of the championship).",
        "Endurance and rallies: a crew shares the result of its car; cars are only compared within their class.",
        "weight: multiplier of the points of a session of this championship (a rally is one long event).",
        "class_weights: [regex on the class of the car, multiplier, offset of the newcomer rating], first match wins (no match: the top class).",
        "Rankings: 'all' by peak rating, 'active' by current rating, only drivers with rank_min_sessions sessions and rank_min_races races (race + sprint).",
        "Drivers below the thresholds are still rated (and rate their opponents): they are only hidden from the rankings.",
        "A change here rebuilds the database at the next start."
    ],
    "k": 24,
    "provisional_sessions": 15,
    "provisional_factor": 2,
    "window": 4,
    "weights": { "race": 1.0, "sprint": 0.6, "qualifying": 0.1 },
    "dnf_weight": 0.5,
    "class_weights": [
        ["(?i)\\b(am|pro-?am|gtc|pc|challenge|cup)\\b", 0.5, -250],
        ["(?i)lmp3|\\bp3\\b|gt(?!p)", 0.6, -150],
        ["(?i)lmp2|\\bp2\\b|lmpc", 0.8, -50]
    ],
    "peak_min_sessions": 25,
    "rank_min_sessions": 30,
    "rank_min_races": 50,
    "active_years": 2,
    "driverdle": {
        "classic": { "min_elo": 1300, "limit": 500 },
        "all": { "min_peak": 1550, "limit": 500 }
    },
    "default": { "base": 1400, "mode": "window" },
    "championships": {
        "Formula_1": { "base": 1650, "mode": "teammate" },
        "MotoGP": { "base": 1650, "mode": "teammate" },
        "Grand_Prix_500cc": { "base": 1650, "mode": "teammate" },
        "World_Rally_Championship_WRC": { "base": 1600, "mode": "window", "weight": 1.5 },
        "World_Endurance_Championship_WEC": { "base": 1550, "mode": "window" },
        "Formula_2": { "base": 1550, "mode": "spec" },
        "GP2_Series": { "base": 1550, "mode": "spec" },
        "Formula_E": { "base": 1550, "mode": "window" },
        "Moto2": { "base": 1550, "mode": "window" },
        "Grand_Prix_350cc": { "base": 1550, "mode": "teammate" },
        "Grand_Prix_250cc": { "base": 1550, "mode": "teammate" },
        "IMSA_SportsCar_Championship": { "base": 1500, "mode": "window" },
        "American_Le_Mans_Series_ALMS": { "base": 1500, "mode": "window" },
        "Formula_3": { "base": 1500, "mode": "spec" },
        "GP3_Series": { "base": 1500, "mode": "spec" },
        "Formula_v8_3-5": { "base": 1500, "mode": "spec" },
        "European_Le_Mans_Series_ELMS": { "base": 1450, "mode": "window" },
        "Formula3_European_Championship_FIAF3EURO": { "base": 1450, "mode": "window" },
        "Formula3_Euro_Series_F3EURO": { "base": 1450, "mode": "window" },
        "World_Touring_Car_Championship_WTCC": { "base": 1450, "mode": "window" },
        "Moto3": { "base": 1450, "mode": "window" },
        "Grand_Prix_125cc": { "base": 1450, "mode": "teammate" },
        "MotoE": { "base": 1450, "mode": "spec" },
        "WRC2": { "base": 1450, "mode": "window", "weight": 1.5 },
        "Asian_Le_Mans_Series_AsLMS": { "base": 1400, "mode": "window" },
        "P-WRC": { "base": 1400, "mode": "window", "weight": 1.5 },
        "Grand_Prix_80cc": { "base": 1350, "mode": "teammate" },
        "Grand_Prix_50cc": { "base": 1350, "mode": "teammate" },
        "WRC3": { "base": 1350, "mode": "window", "weight": 1.5 },
        "Junior_WRC": { "base": 1350, "mode": "spec", "weight": 1.5 },
        "F1_Academy": { "base": 1300, "mode": "spec" },
        "W-SERIES": { "base": 1300, "mode": "spec" },
        "FIA_Karting_World_Championship_OK": { "base": 1300, "mode": "window" },
        "FIA_Karting_World_Championship_KZ": { "base": 1300, "mode": "window" },
        "FIA_Karting_World_Championship_Junior": { "base": 1200, "mode": "window" },
        "GP_Explorer": { "base": 1000, "mode": "spec" }
    }
