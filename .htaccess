# MotorsportDB .htaccess - SIMPLE PHP VERSION
RewriteEngine On

# Disable directory browsing
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Versioned scripts and styles (includes/assets.php): /assets/v<version>/js/… = /assets/js/…
    RewriteRule ^assets/v[0-9a-f]+/((?:js|css)/.+)$ assets/$1 [END]

    # Block sensitive directories
    RewriteRule ^\.git/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^docker/ - [F,L]
    RewriteRule ^node_modules/ - [F,L]
    RewriteRule ^script/ - [F,L]
    RewriteRule ^tests/ - [F,L]
    # Build script and generated data (SQLite database, sessions)
    RewriteRule ^bin/ - [F,L]
    RewriteRule ^var/ - [F,L]
    RewriteRule \.sqlite$ - [F,L]

    # Block direct access to utility PHP files (not for direct HTTP requests)
    RewriteRule ^sitemap-serve\.php$ - [F,L]
    RewriteRule ^router\.php$ - [F,L]
    
    # Allow JSON files in games directories
    RewriteRule ^games/[^/]+/[^/]+\.json$ - [L]
    
    # Remove trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]
    
    # Sitemap - [END] stops the rewrite loop so the sitemap-serve.php block rule below
    # doesn't fire on the internally-rewritten URL
    RewriteRule ^sitemap\.xml$ sitemap-serve.php [END]

    # Allow direct access to existing files (CSS, JS, images, JSON)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # Allow api, assets, data directories
    RewriteCond %{REQUEST_URI} ^/(api|assets|drivers|teams|races)/
    RewriteRule ^ - [L]
    
    # OLD API REDIRECTS
    RewriteRule ^getDrivers\.php$ api/drivers.php [L,QSA]
    RewriteRule ^getDriversList\.php$ api/drivers-list.php [L,QSA]
    RewriteRule ^getTeams\.php$ api/teams.php [L,QSA]
    RewriteRule ^getTeamsList\.php$ api/teams-list.php [L,QSA]
    RewriteRule ^getRaces\.php$ api/races.php [L,QSA]
    RewriteRule ^getMainPage\.php$ api/search.php [L,QSA]
    
    # OLD ADDRESSES: permanent redirect to the canonical one (public/redirect.php)
    RewriteRule ^index\.html$ public/redirect.php?__to=/ [END,QSA]
    RewriteRule ^(driver|team|race)\.html$ public/redirect.php?__to=/$1 [END,QSA]
    RewriteRule ^(head-to-head|ranking)(\.html)?$ public/redirect.php?__to=/$1.php [END,QSA]
    RewriteRule ^(?:games/)?(guess-who|driverdle)\.html$ public/redirect.php?__to=/games/$1.php [END,QSA]
    RewriteRule ^games/(guess-who|driverdle|driverdle-f1|driverdle-all|driverdle-classic)$ public/redirect.php?__to=/games/$1.php [END,QSA]

    # MAIN PAGES. Canonical: /driver?id=…, /team?id=…, /race?id=…&year=… (the .php
    # addresses of these three are redirected by the page itself), /ranking.php…
    RewriteRule ^(driver|team|race)$ public/$1.php [END,QSA]
    RewriteRule ^(driver|team|race|head-to-head|ranking)\.php$ public/$1.php [END,QSA]
    RewriteRule ^(drivers-list|teams-list|championships)$ public/$1.php [END,QSA]

    # GAMES - Route /games/*.php to public/games/*.php
    RewriteRule ^games/(guess-who|driverdle|driverdle-f1|driverdle-all|driverdle-classic)\.php$ public/games/$1.php [END,QSA]

    # HOME - Route root to public/index.php
    RewriteRule ^$ public/index.php [END]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # JSON (API, data files) is data, not a page for the search engines
    Header always set X-Robots-Tag "noindex" "expr=%{CONTENT_TYPE} =~ m#json#"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self';"
</IfModule>

# Protect sensitive files
<FilesMatch "(^|\/)(\.(env|git|gitignore|dockerignore|htaccess)|docker-compose[\w.-]*\.yml|config\.json|tailwind\.config\.js|README\.md|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
    # a versioned URL never changes content: kept for a year, never revalidated
    <If "%{THE_REQUEST} =~ m#\s/assets/v[0-9a-f]+/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Expires
    </If>
</IfModule>